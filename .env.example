# ─────────────────────────────────────────────
# Database (Supabase PostgreSQL)
# ─────────────────────────────────────────────
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# NextAuth.js
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Twilio (SMS Notifications) — Optional for demo
# ─────────────────────────────────────────────
# Set TWILIO_MOCK_MODE=true to skip real SMS in dev/demo
TWILIO_MOCK_MODE="true"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ─────────────────────────────────────────────
# App Config
# ─────────────────────────────────────────────
# Time in milliseconds before a PENDING request is auto-escalated (default: 3 min)
ESCALATION_TIMEOUT_MS="180000"
