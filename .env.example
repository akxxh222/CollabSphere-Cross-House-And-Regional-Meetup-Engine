# PostgreSQL. Remove brackets and URL-encode special password characters.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Generate both local secrets with: node scripts/setup-secrets.cjs
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="replace-with-an-independent-random-secret"

# Safe demo defaults. Setting either flag to false enables real delivery.
TWILIO_MOCK_MODE="true"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
EMAIL_MOCK_MODE="true"
RESEND_API_KEY=""
EMAIL_FROM="CampusCare <care@example.com>"

# Optional; defaults to demo1234. Use a strong value for a shared demo.
DEMO_SEED_PASSWORD=""
