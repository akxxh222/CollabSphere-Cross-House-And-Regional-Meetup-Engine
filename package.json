{
  "name": "campuscare",
  "version": "0.1.0",
  "description": "A digital solution for IITM students to request, track, and get authorized for hospital visits — with real-time emergency escalation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node scripts/prisma.cjs db push",
    "db:studio": "node scripts/prisma.cjs studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "node scripts/check-db.cjs",
    "db:migrate": "node scripts/prisma.cjs migrate deploy",
    "postinstall": "prisma generate",
    "worker": "node scripts/worker.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akxxh222/CollabSphere-Cross-House-And-Regional-Meetup-Engine.git"
  },
  "keywords": [
    "nextjs",
    "hospital",
    "campus",
    "iitm"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/akxxh222/CollabSphere-Cross-House-And-Regional-Meetup-Engine/issues"
  },
  "homepage": "https://github.com/akxxh222/CollabSphere-Cross-House-And-Regional-Meetup-Engine#readme",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.104.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "next": "^15.5.24",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.30",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.24",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
